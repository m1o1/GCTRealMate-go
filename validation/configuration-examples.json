    {
      "name": "template-corrections",
      "source": "Probe\nop lha r3,0(r4) @ $80001000",
      "config": "# GCTRealMate Go 0.12.0 configuration. Full guide: CONFIGURATION.md.\n# Select explicitly: .\\bin\\gctrm.exe --config gctrm.toml source.asm\n# Or copy beside the executable as <executable-basename>.toml.\n# Bug fixes are enabled; all category flags default false.\n# The default target is GameCube/Wii; other defaults preserve C++ choices.\nversion = 2\nbug_fixes = true\n\n[extensions]\n# Accept .op as an alias for op. False ignores .op lines like C++.\n# CLI/INI: --set=extensions.dot_op=true|false\ndot_op = false\n\n# Accept additional numeric branch forms, such as b 20 or b 16+4.\n# CLI/INI: --set=extensions.branch_expressions=true|false\nbranch_expressions = false\n\n# Accept expanded expressions beyond the reference grammar.\n# CLI/INI: --set=extensions.expression_syntax=true|false\nexpression_syntax = false\n\n# Allow source without an initial named section.\n# CLI/INI: --set=extensions.implicit_sections=true|false\nimplicit_sections = false\n\n# Enable the implemented console mnemonics absent from C++.\n# CLI/INI: --set=extensions.additional_console_instructions=true|false\nadditional_console_instructions = false\n\n# Permit implemented instructions outside GameCube/Wii, including 64-bit integers.\n# False rejects these forms even when bug_fixes is false.\n# CLI/INI: --set=extensions.non_console_instructions=true|false\nnon_console_instructions = false\n\n[semantics]\n# Interpret leading-zero integers as decimal instead of octal.\n# CLI/INI: --set=semantics.decimal_leading_zeros=true|false\ndecimal_leading_zeros = false\n\n# Use C-style operator precedence instead of left-to-right evaluation.\n# CLI/INI: --set=semantics.c_operator_precedence=true|false\nc_operator_precedence = false\n\n# Use signed 64-bit aliases instead of unsigned 32-bit arithmetic.\n# CLI/INI: --set=semantics.signed_64_bit_aliases=true|false\nsigned_64_bit_aliases = false\n\n[encoding]\n# Use GNU prediction-bit conventions instead of C++ conventions.\n# CLI/INI: --set=encoding.gnu_branch_hints=true|false\ngnu_branch_hints = false\n\n# Sign-extend negative byte/half values occupying 32-bit slots.\n# CLI/INI: --set=encoding.sign_extend_data_slots=true|false\nsign_extend_data_slots = false\n\n# Use the alternative quiet float NaN payload.\n# CLI/INI: --set=encoding.alternative_float_nan=true|false\nalternative_float_nan = false\n\n# Use the alternative quiet double NaN payload.\n# CLI/INI: --set=encoding.alternative_double_nan=true|false\nalternative_double_nan = false\n\n[validation]\n# Require register prefixes to match their operand classes.\n# CLI/INI: --set=validation.strict_register_prefixes=true|false\nstrict_register_prefixes = false\n\n# Reject duplicate labels instead of using the first definition.\n# CLI/INI: --set=validation.reject_duplicate_labels=true|false\nreject_duplicate_labels = false\n\n# Reject extra macro arguments and missing closing parentheses.\n# CLI/INI: --set=validation.strict_macro_calls=true|false\nstrict_macro_calls = false\n\n# Reject undefined macros instead of expanding them to nothing.\n# CLI/INI: --set=validation.reject_undefined_macros=true|false\nreject_undefined_macros = false\n\n# Reject trailing annotations after source addresses.\n# CLI/INI: --set=validation.reject_address_annotations=true|false\nreject_address_annotations = false\n\n# Reject out-of-range integer data instead of truncating it.\n# CLI/INI: --set=validation.reject_data_overflow=true|false\nreject_data_overflow = false\n\n[cli]\n# Match INI basenames exactly instead of matching prefixes.\n# CLI/INI: --set=cli.exact_ini_matching=true|false\nexact_ini_matching = false\n\n# Write a flat code list instead of the include tree.\n# CLI/INI: --set=cli.flat_logs=true|false\nflat_logs = false\n\n# Write LF on every host instead of native text newlines.\n# CLI/INI: --set=cli.lf_line_endings=true|false\nlf_line_endings = false\n",
      "flags": [],
